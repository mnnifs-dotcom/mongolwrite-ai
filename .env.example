# Copy to .env — never commit real secrets.

APP_ENV=development
SECRET_KEY=change-me-in-production

POSTGRES_USER=mongolwrite
POSTGRES_PASSWORD=mongolwrite
POSTGRES_DB=mongolwrite
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mongolwrite:mongolwrite@localhost:5432/mongolwrite

# Optional shared Hunspell membership cache (leave empty on single-machine Fly).
# REDIS_URL=redis://localhost:6379/0
# Concurrent spell-checks per process (default 3).
# CHECK_CONCURRENCY=3
REDIS_URL=
CHECK_CONCURRENCY=3

API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

GOOGLE_CLIENT_ID=

ADMIN_USERNAME=Admin write
ADMIN_PASSWORD=Ilove@00

# QPay merchant (username / password / invoice_code from QPay after contract).
# Sandbox: https://merchant-sandbox.qpay.mn/v2
# Production: https://merchant.qpay.mn/v2
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_CALLBACK_URL=https://mongolwrite.com/api/v1/billing/qpay/callback
# Fly egress IPv4 for QPay allowlist (if required): 216.246.19.69

